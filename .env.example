# ---------------------------------------------------------------------------
# Copy to `.env.local` for development. NEVER commit a filled-in copy.
# Every variable here is validated at boot by src/server/config/env.ts —
# the process refuses to start in production if a secret is missing or weak.
# ---------------------------------------------------------------------------

# Runtime -------------------------------------------------------------------
NODE_ENV=development

# Public origin, used for absolute URLs and cookie/CSRF origin checks.
# In production this MUST be the real https origin.
APP_ORIGIN=http://localhost:3000

# Database ------------------------------------------------------------------
# Postgres connection string. In development you may instead set
# DATABASE_DRIVER=pglite to run an in-process Postgres with no server.
DATABASE_DRIVER=pglite
DATABASE_URL=postgres://mothaf:mothaf@localhost:5432/mothaf
# Directory used when DATABASE_DRIVER=pglite
PGLITE_DATA_DIR=./.pgdata

# Security ------------------------------------------------------------------
# 32+ random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=replace-me-with-32-random-bytes-base64

# Media storage -------------------------------------------------------------
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage

# Only required when STORAGE_DRIVER=s3
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_BASE_URL=

# Uploads -------------------------------------------------------------------
MAX_UPLOAD_BYTES=52428800
MAX_IMAGE_PIXELS=80000000

# Analytics -----------------------------------------------------------------
# Privacy-first: no cookies, no cross-site identifiers. Salt is rotated daily
# so visitor hashes cannot be correlated across days.
ANALYTICS_ENABLED=true
ANALYTICS_SALT=replace-me-with-another-random-value

# Bootstrap -----------------------------------------------------------------
# Used once by `npm run db:seed` to create the first super admin.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
